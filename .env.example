# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# App Settings
VECTOR_STORE_TYPE=faiss        # faiss or chroma
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
